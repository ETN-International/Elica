# ─────────────────────────────────────────────────────────────
# ETN Genoma — variabili d'ambiente del frontend (Vite)
# Copia questo file in `.env.local` e compila i valori.
# Tutte le variabili esposte al browser DEVONO iniziare con VITE_.
# ─────────────────────────────────────────────────────────────

# ── Cervello 1 (consigliato): AXON BRAIN sul DGX Spark ────────────
# Endpoint OpenAI-compatibile del modello locale (Qwen3.5-122B) servito
# dallo Spark. Il browser lo chiama direttamente (CORS aperto): costo 0.
# Deve essere raggiungibile dai PC dell'aula (stessa LAN o Tailscale).
#   LAN:        http://192.168.188.29:8088/v1
#   Tailscale:  http://100.72.206.121:8088/v1
VITE_SPARK_URL=
# (Opzionale) nome del modello; default Qwen3.5-122B.
VITE_SPARK_MODEL=unsloth/Qwen3.5-122B-A10B-GGUF:UD-Q4_K_XL

# ── Cervello 2 (alternativa): PROXY ANTHROPIC ─────────────────────
# Usato solo se VITE_SPARK_URL è vuoto. La chiave API sta nella Edge
# Function, mai nel browser. Esempio Supabase:
#   https://<project-ref>.supabase.co/functions/v1/ai-proxy
VITE_AI_PROXY_URL=

# (Opzionale) chiave "anon" di Supabase, se la Edge Function richiede
# il bearer di default. Non è la service_role key.
VITE_SUPABASE_ANON_KEY=

# Nota: i dossier sono salvati nel browser (localStorage). Il salvataggio
# server-side su Supabase non è ancora implementato.
