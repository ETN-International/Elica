# ─────────────────────────────────────────────────────────────
# ETN Genoma — variabili d'ambiente del frontend (Vite)
# Copia questo file in `.env.local` e compila i valori.
# Tutte le variabili esposte al browser DEVONO iniziare con VITE_.
# ─────────────────────────────────────────────────────────────

# URL della Edge Function che fa da proxy verso il modello AI.
# È l'UNICO punto che parla con l'AI: la chiave API sta nella function,
# mai nel browser. Esempio Supabase:
#   https://<project-ref>.supabase.co/functions/v1/ai-proxy
VITE_AI_PROXY_URL=

# (Opzionale) chiave "anon" di Supabase, se la Edge Function richiede
# il bearer di default. Non è la service_role key.
VITE_SUPABASE_ANON_KEY=

# (Opzionale) Supabase per salvare i dossier lato server.
# Se non impostati, l'app salva i dossier nel browser (localStorage).
VITE_SUPABASE_URL=
